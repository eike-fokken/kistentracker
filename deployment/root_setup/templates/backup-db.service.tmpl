[Unit]
Description=SQLite backup of Kistentracker database ({{DATA_VOLUME}} volume, podman)
{{AFTER_BACKEND_LINE}}

[Service]
Type=oneshot
{{USER_GROUP_LINES}}{{RUNTIME_ENV_LINE}}Nice=10
IOSchedulingClass=idle
SyslogIdentifier=%N
WorkingDirectory={{BACKUP_DIR}}
ExecStartPre=/usr/bin/mkdir -p {{BACKUP_DIR}}/dbborgbackup

ExecStart={{PODMAN}} run \
    --rm \
    -v {{DATA_VOLUME}}:/data \
    -v {{BACKUP_DIR}}:/backup \
    docker.io/library/python:3.13-slim \
    python -u -c "import sqlite3; \
src=sqlite3.connect('/data/db.sqlite3'); \
dst=sqlite3.connect('/backup/db.sqlite3'); \
src.backup(dst); \
dst.close(); \
src.close()"
ExecStart=/usr/bin/sh -c 'test -f {{BACKUP_DIR}}/dbborgbackup/config || borg init --encryption=none {{BACKUP_DIR}}/dbborgbackup'

ExecStart=/usr/bin/borg create \
    --compression zstd \
    dbborgbackup::{now:%%Y-%%m-%%d_%%H:%%M:%%S} \
    db.sqlite3

ExecStart=/usr/bin/borg prune \
    --keep-minutely 120 \
    --keep-hourly -1 \
    dbborgbackup

ExecStart=/usr/bin/echo "Backup written"
